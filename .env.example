# ====== BẮT BUỘC ======
# ID file Google Sheet (đoạn giữa /d/ và /edit trong đường link)
SPREADSHEET_ID=
# Nội dung file JSON khóa service account (dán nguyên 1 dòng, hoặc mã hóa base64)
GOOGLE_SERVICE_ACCOUNT_JSON=
# Chuỗi bí mật ngẫu nhiên >= 32 ký tự để ký phiên đăng nhập (tạo bằng: openssl rand -hex 32)
SESSION_SECRET=
# ID thư mục Drive lưu file (nằm trong Bộ nhớ dùng chung / Shared drive)
UPLOAD_FOLDER_ID=
# Email được thêm làm ADMIN khi chạy npm run setup
ADMIN_EMAIL=

# ====== EMAIL (SMTP) ======
# Gmail/Google Workspace: bật Xác minh 2 bước, tạo "Mật khẩu ứng dụng" rồi dán vào SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Cổng hồ sơ nhân sự <hr@kdi.edu.vn>"
# MAIL_MODE=console   # bật dòng này để thử: email chỉ in ra log, không gửi thật

# ====== TÙY CHỌN ======
APP_URL=https://hoso.example.com
APP_NAME=Cổng hồ sơ nhân sự
ORG_NAME=KDI Education
PORT=8080
# GOOGLE_IMPERSONATE=hr@kdi.edu.vn     # nếu dùng domain-wide delegation thay vì Shared drive
# APPSHEET_PATH_PREFIX=ThongTinCaNhan_Files_/
# BLOCKED_WORK_STATUS=Nghỉ việc,Đã nghỉ việc
# SESSION_HOURS=12
# MAX_FILE_MB=10
